# Netlify response headers. Fonts never change, so browsers keep them for a year;
# photos and icons for 30 days. HTML, CSS and JS keep Netlify's default (always revalidate),
# so edits to the page show up immediately.

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=2592000
/favicon.svg
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
